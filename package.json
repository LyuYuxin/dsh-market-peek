{
  "name": "dsh-market-peek",
  "version": "0.2.1",
  "type": "module",
  "description": "Preview plugin-market entries inside DSH: open the repository in the right Sidebar's built-in browser, or show its README in a panel docked beside the market.",
  "license": "MIT",
  "author": {
    "name": "LyuYuxin",
    "url": "https://github.com/LyuYuxin"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyuYuxin/dsh-market-peek.git"
  },
  "homepage": "https://github.com/LyuYuxin/dsh-market-peek#readme",
  "bugs": {
    "url": "https://github.com/LyuYuxin/dsh-market-peek/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "locale/*.json",
    "icon.svg",
    "assets",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dshmarket",
    "plugin-market",
    "readme",
    "preview"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
